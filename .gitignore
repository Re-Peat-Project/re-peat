__pycache__/
*.egg-info/
.pytest_cache/
data/synthetic/
_out/

# regenerable GIS outputs of the reports (rebuild: python -m national.profile)
reports/**/*.gpkg
reports/**/cache/
reports/**/*.log
reports/*.bak
reports/**/dashboard_data.json

# machine-specific overrides of pipeline.yaml
pipeline.local.yaml

# tile sources of the dashboard map layers (rebuild: repeat-national-dashboard)
reports/**/tiles/src/
reports/**/tiles/by_khg/
reports/**/*.pmtiles-journal

# local backup made before the per-KHG tile rebuild (2026-11-02)
reports/national_profile_backup_20261102/

# run markers of the national profile builds (timestamps only)
reports/**/*.start

# machine-specific settings of tools/national_run.py (copy of docker/batch.example.toml)
docker/batch.toml

# a peer's settings of docker/compose.yaml (copy of docker/peer.example.env)
docker/.env

# national fire by land status: 30 m review rasters (rebuild: repeat-national-fire)
reports/**/fire_landstatus/layers/tiles/
reports/**/fire_landstatus/layers/status.vrt

# PPEG verification evidence: lists licence holders, kept locally for reports, not published
reports/investigations/ppeg_verification.md
reports/investigations/ppeg_verification_disagreements.csv

# national prioritisation: Earth Engine request cache, per-KHG overlay parts, saved copy of the final tables
reports/**/final_inputs/gee_cache/
reports/**/overlay_all/parts/
reports/**/final_v2_pre_whole/

# national prioritisation working files, kept local: overlay tables (list licence holders), Earth Engine job state of the
# 2026 Sentinel-2 burned area, the whole-KHG peat patches, and the example tables of tools/technical_example.py (all regenerable)
reports/**/overlay_all/
reports/**/final_inputs/burned_s2/
reports/**/whole_khg/patches/
reports/**/whole_khg/*.vrt
reports/**/whole_khg/config.yaml
reports/**/technical_example/

# team deck reviewed on 13 Nov 2026 and its review note: internal team material, kept local
docs/reference/Canal Blocking for Peatland Restoration 131126.pdf
docs/reference/canal_blocking_review_20261113.md
