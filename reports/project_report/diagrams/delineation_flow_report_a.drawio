<mxfile host="drawio">
  <diagram id="delineation_flow_report_a" name="Sub-KHG delineation: inputs and routing">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="740" pageHeight="806" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ha" value="Inputs" style="fontFamily=Source Sans 3;fontColor=#1F2A30;text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;spacingLeft=0;fontStyle=1;fontColor=#5F6B70;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="260" height="28" as="geometry" />
        </mxCell>
        <mxCell id="hb" value="Processing" style="fontFamily=Source Sans 3;fontColor=#1F2A30;text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;spacingLeft=0;fontStyle=1;fontColor=#5F6B70;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="300" y="0" width="440" height="28" as="geometry" />
        </mxCell>
        <mxCell id="g" value="&lt;b&gt;1. Grid&lt;/b&gt;&lt;br&gt;30 m grid over the KHG plus 1 km" style="fontFamily=Source Sans 3;fontColor=#1F2A30;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;spacing=6;strokeWidth=1.25;fillColor=#E3EDEC;strokeColor=#0B5D5B;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="300" y="40" width="440" height="52" as="geometry" />
        </mxCell>
        <mxCell id="khg" value="&lt;b&gt;KHG boundary&lt;/b&gt;" style="fontFamily=Source Sans 3;fontColor=#1F2A30;shape=cylinder3;boundedLbl=1;size=8;whiteSpace=wrap;html=1;spacing=6;strokeWidth=1.25;fillColor=#FFFFFF;strokeColor=#5F6B70;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="0" y="40" width="260" height="52" as="geometry" />
        </mxCell>
        <mxCell id="w" value="&lt;b&gt;2. DTM onto the grid&lt;/b&gt;&lt;br&gt;bilinear; cells without DTM leave the KHG (warning above 1 %)" style="fontFamily=Source Sans 3;fontColor=#1F2A30;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;spacing=6;strokeWidth=1.25;fillColor=#E3EDEC;strokeColor=#0B5D5B;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="300" y="122" width="440" height="88" as="geometry" />
        </mxCell>
        <mxCell id="dtm" value="&lt;b&gt;Ground DTM&lt;/b&gt;&lt;br&gt;corrected DTM or LiDAR; a surface model gives wrong catchments" style="fontFamily=Source Sans 3;fontColor=#1F2A30;shape=cylinder3;boundedLbl=1;size=8;whiteSpace=wrap;html=1;spacing=6;strokeWidth=1.25;fillColor=#FFFFFF;strokeColor=#5F6B70;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="0" y="122" width="260" height="88" as="geometry" />
        </mxCell>
        <mxCell id="riv" value="&lt;b&gt;Rivers and lakes&lt;/b&gt;&lt;br&gt;always unit boundaries" style="fontFamily=Source Sans 3;fontColor=#1F2A30;shape=cylinder3;boundedLbl=1;size=8;whiteSpace=wrap;html=1;spacing=6;strokeWidth=1.25;fillColor=#FFFFFF;strokeColor=#5F6B70;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="0" y="240" width="260" height="68" as="geometry" />
        </mxCell>
        <mxCell id="can" value="&lt;b&gt;Canals by class&lt;/b&gt;&lt;br&gt;primary, secondary, tertiary" style="fontFamily=Source Sans 3;fontColor=#1F2A30;shape=cylinder3;boundedLbl=1;size=8;whiteSpace=wrap;html=1;spacing=6;strokeWidth=1.25;fillColor=#FFFFFF;strokeColor=#5F6B70;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="0" y="320" width="260" height="68" as="geometry" />
        </mxCell>
        <mxCell id="ch" value="&lt;b&gt;3. Channel masks&lt;/b&gt;&lt;br&gt;rivers and lakes; all canals; &lt;b&gt;outlet canals&lt;/b&gt;: primary and secondary canals&lt;br&gt;outlets = rivers + outlet canals" style="fontFamily=Source Sans 3;fontColor=#1F2A30;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;spacing=6;strokeWidth=1.25;fillColor=#E3EDEC;strokeColor=#0B5D5B;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="300" y="240" width="440" height="148" as="geometry" />
        </mxCell>
        <mxCell id="b" value="&lt;b&gt;4. Burn&lt;/b&gt;&lt;br&gt;DTM lowered 3 m under rivers and all canals (canals are narrower than a cell)" style="fontFamily=Source Sans 3;fontColor=#1F2A30;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;spacing=6;strokeWidth=1.25;fillColor=#E3EDEC;strokeColor=#0B5D5B;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="300" y="418" width="440" height="68" as="geometry" />
        </mxCell>
        <mxCell id="d8" value="&lt;b&gt;5. Condition and route&lt;/b&gt;&lt;br&gt;fill pits and depressions, resolve flats; D8 flow direction; flow accumulation" style="fontFamily=Source Sans 3;fontColor=#1F2A30;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;spacing=6;strokeWidth=1.25;fillColor=#E3EDEC;strokeColor=#0B5D5B;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="300" y="516" width="440" height="68" as="geometry" />
        </mxCell>
        <mxCell id="acc" value="&lt;b&gt;Flow accumulation&lt;/b&gt; grid" style="fontFamily=Source Sans 3;fontColor=#1F2A30;shape=cylinder3;boundedLbl=1;size=8;whiteSpace=wrap;html=1;spacing=6;strokeWidth=1.25;fillColor=#F6E9E0;strokeColor=#C2632E;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="0" y="516" width="260" height="68" as="geometry" />
        </mxCell>
        <mxCell id="fb" value="&lt;b&gt;Fallback&lt;/b&gt;&lt;br&gt;no flow directions: units = land enclosed by the mapped outlets; target count ignored" style="fontFamily=Source Sans 3;fontColor=#1F2A30;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;spacing=6;strokeWidth=1.25;fillColor=#F4F6F6;strokeColor=#B8C4C2;dashed=1;fontColor=#5F6B70;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="300" y="620" width="440" height="68" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;Where the boundaries come from&lt;/b&gt;&lt;br&gt;mapped outlets (rivers, outlet canals) are fixed boundaries; inside them the DTM decides only the divides (steps 4-8), and step 9 decides which pieces join. Without outlets inside the KHG, small DTM changes move the divides and the merges" style="fontFamily=Source Sans 3;fontColor=#1F2A30;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;spacing=6;strokeWidth=1.25;fillColor=#F4F6F6;strokeColor=#B8C4C2;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="0" y="718" width="740" height="88" as="geometry" />
        </mxCell>
        <mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.25;strokeColor=#5F6B70;endArrow=block;endFill=1;endSize=7;fontFamily=Source Sans 3;fontSize=14;fontColor=#1F2A30;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="khg" target="g">
