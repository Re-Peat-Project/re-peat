          <mxGeometry x="0" y="0" width="260" height="28" as="geometry" />
        </mxCell>
        <mxCell id="hb" value="Processing" style="fontFamily=Source Sans 3;fontColor=#1F2A30;text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;spacingLeft=0;fontStyle=1;fontColor=#5F6B70;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="300" y="0" width="440" height="28" as="geometry" />
        </mxCell>
        <mxCell id="d8" value="&lt;b&gt;5. Condition and route&lt;/b&gt;&lt;br&gt;D8 flow direction; flow accumulation" style="fontFamily=Source Sans 3;fontColor=#1F2A30;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;spacing=6;strokeWidth=1.25;fillColor=#F4F6F6;strokeColor=#B8C4C2;dashed=1;fontColor=#5F6B70;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="300" y="40" width="440" height="52" as="geometry" />
        </mxCell>
        <mxCell id="so" value="&lt;b&gt;6. DEM streams&lt;/b&gt;&lt;br&gt;from 2 km² of contributing area; Strahler order" style="fontFamily=Source Sans 3;fontColor=#1F2A30;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;spacing=6;strokeWidth=1.25;fillColor=#E3EDEC;strokeColor=#0B5D5B;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="300" y="122" width="440" height="52" as="geometry" />
        </mxCell>
        <mxCell id="ord" value="&lt;b&gt;Stream order&lt;/b&gt; grid" style="fontFamily=Source Sans 3;fontColor=#1F2A30;shape=cylinder3;boundedLbl=1;size=8;whiteSpace=wrap;html=1;spacing=6;strokeWidth=1.25;fillColor=#F6E9E0;strokeColor=#C2632E;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="0" y="122" width="260" height="52" as="geometry" />
        </mxCell>
        <mxCell id="os" value="&lt;b&gt;7. Choose the outlet set&lt;/b&gt;&lt;br&gt;mapped outlets alone first; if the unit count is outside 6-30, add DEM streams from the highest order down" style="fontFamily=Source Sans 3;fontColor=#1F2A30;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;spacing=6;strokeWidth=1.25;fillColor=#E3EDEC;strokeColor=#0B5D5B;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="300" y="204" width="440" height="68" as="geometry" />
        </mxCell>
        <mxCell id="pc" value="&lt;b&gt;8. Pieces&lt;/b&gt;&lt;br&gt;outlet network cut into reaches at junctions; every cell traced downstream to its first outlet cell = the catchment of that reach, split by bank. Flow leaving the KHG without an outlet: coastal catchments, cut into pieces of about 50 km²" style="fontFamily=Source Sans 3;fontColor=#1F2A30;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;spacing=6;strokeWidth=1.25;fillColor=#E3EDEC;strokeColor=#0B5D5B;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="300" y="302" width="440" height="104" as="geometry" />
        </mxCell>
        <mxCell id="mg" value="&lt;b&gt;9. Merge small pieces&lt;/b&gt;&lt;br&gt;pieces under the minimum area join, smallest first, the neighbour with the longest shared &lt;i&gt;divide&lt;/i&gt; (a border across an outlet channel only if there is no divide neighbour). Minimum area starts at 5 km² and rises 10 % at a time until at most 30 units remain" style="fontFamily=Source Sans 3;fontColor=#1F2A30;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;spacing=6;strokeWidth=1.25;fillColor=#E3EDEC;strokeColor=#0B5D5B;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="300" y="436" width="440" height="104" as="geometry" />
        </mxCell>
        <mxCell id="fn" value="&lt;b&gt;10. Units&lt;/b&gt;&lt;br&gt;channel cells go to the nearest unit; clipped to the KHG; polygons numbered north to south" style="fontFamily=Source Sans 3;fontColor=#1F2A30;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;spacing=6;strokeWidth=1.25;fillColor=#E3EDEC;strokeColor=#0B5D5B;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="300" y="570" width="440" height="68" as="geometry" />
        </mxCell>
