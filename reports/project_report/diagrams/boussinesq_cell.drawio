<mxfile host="drawio">
  <diagram id="boussinesq_cell" name="Boussinesq equation, one cell">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="700" pageHeight="368" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rain" value="&lt;b&gt;Rain&lt;/b&gt;&lt;br&gt;added to the water table" style="fontFamily=Source Sans 3;fontColor=#1F2A30;shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=12;whiteSpace=wrap;html=1;spacing=6;spacingLeft=10;spacingRight=10;strokeWidth=1.25;fillColor=#FFFFFF;strokeColor=#5F6B70;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="130" y="0" width="200" height="68" as="geometry" />
        </mxCell>
        <mxCell id="et" value="&lt;b&gt;Evapotranspiration&lt;/b&gt;&lt;br&gt;removed from it" style="fontFamily=Source Sans 3;fontColor=#1F2A30;shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=12;whiteSpace=wrap;html=1;spacing=6;spacingLeft=10;spacingRight=10;strokeWidth=1.25;fillColor=#FFFFFF;strokeColor=#5F6B70;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="370" y="0" width="200" height="68" as="geometry" />
        </mxCell>
        <mxCell id="left" value="&lt;b&gt;Neighbouring cell&lt;/b&gt;&lt;br&gt;higher water table" style="fontFamily=Source Sans 3;fontColor=#1F2A30;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;spacing=6;strokeWidth=1.25;fillColor=#FFFFFF;strokeColor=#5F6B70;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="0" y="118" width="190" height="52" as="geometry" />
        </mxCell>
        <mxCell id="cell" value="&lt;b&gt;This cell&lt;/b&gt;&lt;br&gt;water table height" style="fontFamily=Source Sans 3;fontColor=#1F2A30;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;spacing=6;strokeWidth=1.25;fillColor=#E3EDEC;strokeColor=#0B5D5B;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="260" y="118" width="180" height="52" as="geometry" />
        </mxCell>
        <mxCell id="right" value="&lt;b&gt;Neighbouring cell or canal&lt;/b&gt;&lt;br&gt;lower water table; a canal level is held" style="fontFamily=Source Sans 3;fontColor=#1F2A30;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;spacing=6;strokeWidth=1.25;fillColor=#FFFFFF;strokeColor=#5F6B70;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="510" y="118" width="190" height="88" as="geometry" />
        </mxCell>
        <mxCell id="out" value="&lt;b&gt;Change of the water table in one day&lt;/b&gt; = (rain - evapotranspiration + inflow from neighbours - outflow to neighbours) divided by the specific yield" style="fontFamily=Source Sans 3;fontColor=#1F2A30;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;spacing=6;strokeWidth=1.25;fillColor=#F6E9E0;strokeColor=#C2632E;fontSize=15;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="0" y="220" width="700" height="56" as="geometry" />
        </mxCell>
        <mxCell id="terms" value="&lt;b&gt;Specific yield&lt;/b&gt;: the share of the peat volume that drains for each metre the water table falls. &lt;b&gt;Transmissivity&lt;/b&gt;: how much water the saturated peat carries sideways. Flow between two cells is the transmissivity times the slope of the water table between them." style="fontFamily=Source Sans 3;fontColor=#1F2A30;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;spacing=6;strokeWidth=1.25;fillColor=#F4F6F6;strokeColor=#B8C4C2;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="0" y="296" width="700" height="72" as="geometry" />
        </mxCell>
        <mxCell id="e_rain" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.25;strokeColor=#5F6B70;endArrow=block;endFill=1;endSize=7;fontFamily=Source Sans 3;fontSize=14;fontColor=#1F2A30;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.825;exitY=1;exitDx=0;exitDy=0;entryX=0.1944;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rain" target="cell">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_et" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.25;strokeColor=#5F6B70;endArrow=block;endFill=1;endSize=7;fontFamily=Source Sans 3;fontSize=14;fontColor=#1F2A30;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.8056;exitY=0;exitDx=0;exitDy=0;entryX=0.175;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="cell" target="et">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_left" value="flow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.25;strokeColor=#5F6B70;endArrow=block;endFill=1;endSize=7;fontFamily=Source Sans 3;fontSize=14;fontColor=#1F2A30;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="left" target="cell">
          <mxGeometry relative="1" as="geometry" />
