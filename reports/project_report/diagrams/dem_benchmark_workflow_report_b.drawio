        <mxCell id="n60" value="&lt;b&gt;Side checks&lt;/b&gt;&lt;br&gt;reference resolution (2 m against 24 m blocks), contour source and spacing, tiling, load alignment" style="fontFamily=Source Sans 3;fontColor=#1F2A30;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;spacing=6;strokeWidth=1.25;fillColor=#F4F6F6;strokeColor=#B8C4C2;dashed=1;fontColor=#5F6B70;fontSize=15;" vertex="1" parent="1">
