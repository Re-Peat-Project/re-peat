  <diagram id="pump_method_report_c" name="RE-PEAT Interventions: stage 12">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="740" pageHeight="692" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c53" value="E. Interventions, budget and report (stage 12, always last)" style="fontFamily=Source Sans 3;fontColor=#1F2A30;lane=1;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.25;fillColor=none;strokeColor=#B8C4C2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#5F6B70;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="740" height="692" as="geometry" />
        </mxCell>
        <mxCell id="c57" value="&lt;b&gt;12a. Interventions&lt;/b&gt; per sub-KHG (water held from stage 7), first rule that holds: protected peat ≥ 0.5 → close or backfill canals · dry (NDMI &amp;lt; 0.30) or burned (≥ 0.25) and canal reach &amp;lt; 0.4 → revegetation and fire readiness · reach ≥ 0.4, blocks hold &amp;lt; 0.5 of the deficit, water within 5 km → blocks and water supply · same but no water within 5 km, dry or burned → blocks and deep wells · reach ≥ 0.4 → blocks · else maintain. Held = rise × Sy 0.15 × 600 m" style="fontFamily=Source Sans 3;fontColor=#1F2A30;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;spacing=6;strokeWidth=1.25;fillColor=#E3EDEC;strokeColor=#0B5D5B;fontSize=15;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="40" width="420" height="240" as="geometry" />
        </mxCell>
        <mxCell id="c54" value="&lt;b&gt;Sub-KHG indicators&lt;/b&gt; from the prioritisation: protected share, NDMI, burned share, canal reach, distance to water, canal density" style="fontFamily=Source Sans 3;fontColor=#1F2A30;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;spacing=6;strokeWidth=1.25;fillColor=#FFFFFF;strokeColor=#5F6B70;fontSize=15;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
