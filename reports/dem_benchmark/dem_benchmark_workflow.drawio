="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n61" target="n62"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n77" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.1306;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n59" target="n62"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n78" value="&lt;b&gt;Step 05&lt;/b&gt; dem_benchmark_pipeline.py (Sugihan-Lumpur)&lt;br&gt;site configs; only the DTM changes; LiDAR runs as the truth variant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1560" y="784" width="300" height="58" as="geometry"/></mxCell><mxCell id="n79" value="&lt;b&gt;repeat-delineation&lt;/b&gt; per DTM variant&lt;br&gt;sub-KHG units, matched to the LiDAR units (IoU)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1560" y="866" width="300" height="58" as="geometry"/></mxCell><mxCell id="n80" value="&lt;b&gt;repeat-neraca&lt;/b&gt; tier 1 + 2 per DTM variant&lt;br&gt;on the LiDAR units, same forcing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1560" y="948" width="300" height="58" as="geometry"/></mxCell><mxCell id="n81" value="&lt;b&gt;Compare&lt;/b&gt; delineation_compare.csv,&lt;br&gt;neraca_compare.csv, neraca_unit_compare.csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1560" y="1030" width="300" height="58" as="geometry"/></mxCell><mxCell id="n82" value="&lt;b&gt;Report&lt;/b&gt; re-peat/reports/dem_benchmark/report.md&lt;br&gt;(tools/dem_benchmark_report.py, from the CSVs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1560" y="1112" width="300" height="58" as="geometry"/></mxCell><mxCell id="n83" value="&lt;b&gt;Product&lt;/b&gt;: the DTM and processing for sub-KHG delineation and neraca air, with its measured error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1560" y="1194" width="300" height="58" as="geometry"/></mxCell><mxCell id="n84" value="processed DTMs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n59" target="n78"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n85" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n78" target="n79"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n86" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n79" target="n80"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n87" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n80" target="n81"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n88" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n81" target="n82"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n89" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n82" target="n83"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n90" value="metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n62" target="n82"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1874" y="731.0"/><mxPoint x="1874" y="1141.0"/></Array></mxGeometry></mxCell><mxCell id="n91" value="Not reachable / not used&lt;br&gt;- 4TU (home of DeltaDTM): TCP blocked from this machine, so the Earth Engine copy was used&lt;br&gt;- GEDTM30: host TLS certificate expired (deferred)&lt;br&gt;- FathomDEM, WorldDEM Neo DTM: skipped by decision&lt;br&gt;- KLHK/BRGM: no further data or metadata obtainable" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#ffffcc;strokeColor=#b3b300;fontSize=10;align=left;spacingLeft=4;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="1300" width="260" height="260" as="geometry"/></mxCell><mxCell id="n92" value="How the fetchers behave&lt;br&gt;- files kept as delivered (upstream names, no resampling)&lt;br&gt;- files already present are skipped&lt;br&gt;- one request at a time, with a pause&lt;br&gt;- the Tanahair link is read from the environment, never saved&lt;br&gt;- wrappers in re-peat/tools/" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#ffffcc;strokeColor=#b3b300;fontSize=10;align=left;spacingLeft=4;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="320" y="1300" width="250" height="260" as="geometry"/></mxCell><mxCell id="n93" value="Catalogue: re-peat/sites/data_catalog.csv and docs/14-data-catalog.md (tools/catalog_data.py); source, licence, date and caveats per dataset.&lt;br&gt;&lt;br&gt;Per-KHG availability: docs/16-khg-data-recap.md (tools/khg_data_recap.py)." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#ffffcc;strokeColor=#b3b300;fontSize=10;align=left;spacingLeft=4;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="610" y="1300" width="290" height="260" as="geometry"/></mxCell><mxCell id="n94" value="Found along the way&lt;br&gt;- Old repeat-dem loader shifted the DEM by part of a cell: 0.25 m NMAD from exact interpolation, 0.01 m after the fix (check_load_alignment.py). Earlier repeat-dem runs used the old loader.&lt;br&gt;- Strip-by-strip run equals the single-pass run to 0.000000 m (check_tiling.py).&lt;br&gt;- Memory: DEMNAS 8 m over Sugihan-Lumpur runs in strips with at least 2 km overlap, never coarsened.&lt;br&gt;- The 25 cm KLHK contours were traced from the 20/25 m LiDAR; the BRGM contours from the modelled DTMs.&lt;br&gt;- The LiDAR is held out: it never enters a fit." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#ffffcc;strokeColor=#b3b300;fontSize=10;align=left;spacingLeft=4;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="940" y="1300" width="580" height="260" as="geometry"/></mxCell><mxCell id="n95" value="Results&lt;br&gt;1 km height-difference error, processed: DeltaDTM 0.64 / 0.47 m, KLHK 0.67 / 0.49 m (Mendahara / Sugihan-Lumpur); real relief 0.46 / 0.38 m.&lt;br&gt;Pass criterion (written first): Tier A 0.30 m, Tier B half the real relief: nothing passes.&lt;br&gt;Delineation, mean IoU with LiDAR units: DeltaDTM 0.48, KLHK as used now 0.40.&lt;br&gt;Neraca tier 2: 77% of cells fixed at canals and edge, so it cannot judge the DTMs yet." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#ffffcc;strokeColor=#b3b300;fontSize=10;align=left;spacingLeft=4;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1560" y="1300" width="300" height="260" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>