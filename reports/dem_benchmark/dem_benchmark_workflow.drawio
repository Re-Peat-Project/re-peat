<mxfile host="app.diagrams.net"><diagram name="DEM benchmark workflow" id="dem-benchmark"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" page="1" pageWidth="1920" pageHeight="1620"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="RE-PEAT DEM benchmark: from raw sources to the DTM choice for sub-KHG neraca air" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1840" height="40" as="geometry"/></mxCell><mxCell id="n3" value="Sites: KHG Sungai Mendahara - Sungai Batanghari (terrain benchmark) and KHG Sungai Sugihan - Sungai Lumpur (terrain benchmark + pipeline test). Each row is one dataset, read left to right. Rules: nothing downscaled to fit memory; every input kept in _data and catalogued; every number generated from a file." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#52514e;" vertex="1" parent="1"><mxGeometry x="20" y="36" width="1840" height="36" as="geometry"/></mxCell><mxCell id="n4" value="1. External sources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=14;arcSize=2;" vertex="1" parent="1"><mxGeometry x="10" y="80" width="280" height="1510" as="geometry"/></mxCell><mxCell id="n5" value="2. Fetchers (repeat-common)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7ec;strokeColor=#82b366;verticalAlign=top;fontStyle=1;fontSize=14;arcSize=2;" vertex="1" parent="1"><mxGeometry x="310" y="80" width="270" height="1510" as="geometry"/></mxCell><mxCell id="n6" value="3. Curated data (_data, catalogued)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaeb;strokeColor=#d6b656;verticalAlign=top;fontStyle=1;fontSize=14;arcSize=2;" vertex="1" parent="1"><mxGeometry x="600" y="80" width="310" height="1510" as="geometry"/></mxCell><mxCell id="n7" value="4. Terrain benchmark (repeat-dem)" style="rounded=1;whiteSpace=wrap;html=1;