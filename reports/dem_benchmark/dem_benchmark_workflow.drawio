ry"/></mxCell><mxCell id="n50" value="no fetch: already on disk,&lt;br&gt;catalogued as delivered" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="320" y="538" width="250" height="140" as="geometry"/></mxCell><mxCell id="n51" value="Peat depth and DTM/ (KLHK modelled DTMs)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=7;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="610" y="538" width="290" height="58" as="geometry"/></mxCell><mxCell id="n52" value="lidar_klhk/dem_25m/ (Jambi25m, OKI25: LiDAR)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=7;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="610" y="620" width="290" height="58" as="geometry"/></mxCell><mxCell id="n53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n49" target="n50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.2071;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n50" target="n51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.7929;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n50" target="n52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n56" value="&lt;b&gt;benchmark/&amp;lt;site&amp;gt;.yaml&lt;/b&gt; (tracked)&lt;br&gt;candidates, reference, metrics, pass criterion, processing; written &lt;i&gt;before&lt;/i&gt; any result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="940" y="110" width="300" height="72" as="geometry"/></mxCell><mxCell id="n57" value="&lt;b&gt;Steps 00-01&lt;/b&gt; dem_benchmark.py&lt;br&gt;manifest with sha256 of every input&lt;br&gt;each candidate as a VRT (mosaic by reference: no copy, no resampling)&lt;br&gt;&lt;br&gt;candidates: DEMNAS, GLO-30, FABDEM, DeltaDTM, KLHK modelled DTM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="940" y="210" width="300" height="386" as="geometry"/></mxCell><mxCell id="n58" value="&lt;b&gt;Step 02&lt;/b&gt; candidate minus LiDAR at every LiDAR cell inside the KHG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="940" y="620" width="300" height="58" as="geometry"/></mxCell><mxCell id="n59" value="&lt;b&gt;Step 04&lt;/b&gt; dem_benchmark_process.py + tiled_dtm.py&lt;br&gt;reads the candidate VRTs of step 01; per candidate, native resolution:&lt;br&gt;pass 0 land cover + canopy onto the grid&lt;br&gt;pass 1 fit canopy factor and offset per class to ICESat-2&lt;br&gt;pass 2 correct, despike, smooth, strip by strip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="940" y="702" width="300" height="222" as="geometry"/></mxCell><mxCell id="n60" value="&lt;b&gt;Side checks&lt;/b&gt;&lt;br&gt;reference_resolution_test.py: 2 m vs 24 m blocks&lt;br&gt;check_contour_source.py, contour_grid_spacing.py&lt;br&gt;check_tiling.py, check_load_alignment.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="940" y="948" width="300" height="140" as="geometry"/></mxCell><mxCell id="n61" value="&lt;b&gt;Step 03&lt;/b&gt; metrics: NMAD, error of height differences over 0.5/1/2 km, variogram, land cover, tiers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1270" y="620" width="250" height="58" as="geometry"/></mxCell><mxCell id="n62" value="&lt;b&gt;Re-score&lt;/b&gt; processed surfaces against the LiDAR and the LiDAR smoothed the same way" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1270" y="702" width="250" height="58" as="geometry"/></mxCell><mxCell id="n63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.0751;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514e;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2876;entryDx=0;entryDy=0;" edge="1" parent="1" source="n16" target="n57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n65" value="" style="edgeStyle=orthogonalEdgeStyle;round