# Copy to .env next to compose.yaml (not tracked) and fill in. Forward slashes on Windows.

# one folder for everything the chain reads and writes on your machine; data/, khg/, config/, earthengine/, sitmat/ and work/
# are made inside it (docs/22-running-on-your-machine.md)
REPEAT_DIR=D:/repeat

# your Google Cloud project registered for Earth Engine (non-commercial use is free)
EE_PROJECT=my-earthengine-project

# image to run: the published one (default), or the tag of an image you built yourself
REPEAT_IMAGE=ghcr.io/re-peat-project/repeat-chain:latest

# only to download DEMNAS sheets (optional): a fresh download link from tanahair.indonesia.go.id, valid about an hour
TANAHAIR_LINK=
